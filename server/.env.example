# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB Atlas (or local mongod) ----
MONGODB_URI=mongodb://127.0.0.1:27017/chronovault

# ---- Secrets: generate with `npm run keys` (each must be 64 hex chars / 32 bytes, JWT any long string) ----
MASTER_KEY=
INTEGRITY_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ---- SMTP (Gmail app password or any transactional provider). Leave SMTP_HOST empty to print emails to the console. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ChronoVault <noreply@chronovault.app>"

# ---- Scheduler ----
CRON_EXPR=* * * * *
DISABLE_SCHEDULER=false
