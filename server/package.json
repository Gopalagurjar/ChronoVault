{
  "name": "chronovault-server",
  "version": "1.1.0",
  "description": "ChronoVault - time-locked digital memory & message delivery platform (API + scheduler)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "keys": "node -e \"const c=require('crypto');console.log('MASTER_KEY='+c.randomBytes(32).toString('hex'));console.log('INTEGRITY_KEY='+c.randomBytes(32).toString('hex'));console.log('JWT_SECRET='+c.randomBytes(48).toString('hex'))\""
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": ["src/services/encryption.js", "src/services/evaluators.js", "src/services/scheduler.js"],
    "coverageThreshold": { "global": { "statements": 80 } }
  }
}